{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "strict": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "angularCompilerOptions": { "strictTemplates": true, "strictInjectionParameters": true }
}
